# Скопируйте в .env и заполните. .env НЕ коммитить и не публиковать.
#
# Адрес входа (по умолчанию https://asurso.ru/).
ASURSO_URL=https://asurso.ru/

# Логин/пароль для авто-входа (без них — вход вручную в браузере).
ASURSO_LOGIN=
ASURSO_PASSWORD=

# Организация: отличительная часть названия для автопоиска в select2.
# Для журнала преподавателя нужен основной филиал — «Наянов».
ASURSO_ORG=Наянов

# Путь к БД проекта j-web (по умолчанию C:\websites\na\j-web\db\app.db).
JWEB_DB=C:\websites\na\j-web\db\app.db

# HTTP-экспорт оценок с боевого j-web (см. j-web: GET /api/export/grades).
# JWEB_URL по умолчанию https://j.nayanovaacademy.ru
JWEB_URL=https://j.nayanovaacademy.ru
# Тот же токен, что JWEB_EXPORT_TOKEN в .env проекта j-web
# (на сервере он лежит в db/export_token.txt). Пусто — HTTP-экспорт выключен.
JWEB_EXPORT_TOKEN=

# 1 — запускать браузер без окна (headless).
ASU_HEADLESS=
